{
  "name": "folio-e2e",
  "private": true,
  "description": "Playwright end-to-end tests for Folio, run against an ephemeral instance",
  "scripts": {
    "test": "playwright test",
    "test:telemetry": "playwright test --config telemetry.config.ts",
    "verify:telemetry": "node verify-telemetry.mjs",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2"
  }
}

opt_out_usage

APPLE_DIR = File.expand_path("..", __dir__)
PROJECT = File.join(APPLE_DIR, "Folio", "Folio.xcodeproj")
TEAM_ID = "WPW3QSLZ2F"
APP_IDENTIFIER = "com.cedricziel.folio"
SHARE_IDENTIFIER = "#{APP_IDENTIFIER}.share"
FILE_PROVIDER_IDENTIFIER = "#{APP_IDENTIFIER}.fileprovider"
IDENTIFIERS = [APP_IDENTIFIER, SHARE_IDENTIFIER, FILE_PROVIDER_IDENTIFIER].freeze
APP_GROUP = "group.#{APP_IDENTIFIER}"
XCODEBUILD_FLAGS = "-skipPackagePluginValidation -skipMacroValidation"

default_platform(:ios)

before_all do |_lane, _options|
  # Without setup_ci, codesign on macOS runners hangs on a keychain prompt.
  setup_ci if is_ci
end

def load_app_store_connect_api_key
  return @asc_api_key if @asc_api_key

  env = ->(name) { ENV[name].to_s.strip.empty? ? nil : ENV[name] }
  key_id = env.call("ASC_KEY_ID")
  issuer_id = env.call("ASC_ISSUER_ID")
  key_content = env.call("ASC_KEY_CONTENT")
  if key_id.nil? || issuer_id.nil? || key_content.nil?
    UI.user_error!("Set ASC_KEY_ID, ASC_ISSUER_ID and ASC_KEY_CONTENT (the .p8, raw or base64).")
  end

  @asc_api_key = app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer_id,
    key_content: key_content,
    is_key_content_base64: key_content.match?(/\A[A-Za-z0-9+\/=\s]+\z/) && !key_content.include?("BEGIN PRIVATE KEY"),
    in_house: false
  )
end

def generate_project
  sh("cd '#{APPLE_DIR}/Folio' && xcodegen generate")
end

def changelog_since_last_tag
  tag = sh("git describe --tags --abbrev=0 2>/dev/null || true", log: false).strip
  range = tag.empty? ? "-n 20" : "#{tag}..HEAD"
  log = sh("git log #{range} --no-merges --pretty='- %s' -- :/apple :/openapi :/design/tokens.json", log: false).strip
  log.empty? ? "Maintenance build." : log
end

def register_bundle_ids
  names = {
    APP_IDENTIFIER => "Folio",
    SHARE_IDENTIFIER => "Folio Share Extension",
    FILE_PROVIDER_IDENTIFIER => "Folio File Provider",
  }
  names.each do |identifier, name|
    bundle = Spaceship::ConnectAPI::BundleId.all(filter: { identifier: identifier }).find { |b| b.identifier == identifier }
    if bundle
      UI.message("Bundle ID #{identifier} already registered")
    else
      bundle = Spaceship::ConnectAPI::BundleId.create(name: name, identifier: identifier, platform: "UNIVERSAL")
      UI.success("Registered bundle ID #{identifier}")
    end
    enabled = bundle.get_capabilities.map(&:capability_type)
    next if enabled.include?(Spaceship::ConnectAPI::BundleIdCapability::Type::APP_GROUPS)

    begin
      bundle.create_capability(Spaceship::ConnectAPI::BundleIdCapability::Type::APP_GROUPS)
      UI.success("Enabled App Groups on #{identifier}")
    rescue StandardError => e
      UI.important("Could not enable App Groups on #{identifier}: #{e.message}")
    end
  end

  # Keychain Sharing is an entitlement, not a portal capability, so nothing to enable there.
  UI.important(<<~MSG)
    An API key cannot create an App Group or assign one to an identifier. In the developer portal:
      1. Identifiers -> App Groups -> "+" -> #{APP_GROUP}
      2. For #{IDENTIFIERS.join(', ')}: Edit -> App Groups -> assign #{APP_GROUP}
    Then run `bundle exec fastlane bootstrap` again so the profiles carry the group.
  MSG

  app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
  if app
    UI.message("App record '#{app.name}' already exists")
  else
    UI.important(<<~MSG)
      No App Store Connect app record for #{APP_IDENTIFIER}. Create it once at
      https://appstoreconnect.apple.com/apps -> "+" -> New App
        Platforms: iOS, macOS   Name: Folio   Bundle ID: #{APP_IDENTIFIER}   SKU: #{APP_IDENTIFIER}
    MSG
  end
end

def sign(platform:, force: false)
  match_params = {
    type: "appstore",
    platform: platform,
    app_identifier: IDENTIFIERS,
    readonly: is_ci && !force,
    force: force,
    api_key: load_app_store_connect_api_key,
  }
  match_params[:additional_cert_types] = ["mac_installer_distribution"] if platform == "macos"
  match(**match_params)
end

def mac_installer_identity
  identities = sh("security find-identity -v", log: false)
  name = identities[/"((?:3rd Party Mac Developer Installer|Mac Installer Distribution): [^"]*\(#{TEAM_ID}\))"/, 1]
  UI.user_error!("No Mac installer certificate for team #{TEAM_ID} in the keychain; run `fastlane bootstrap`.") unless name
  name
end

# The release workflow passes the release version (e.g. 0.1.0) so the app version matches the server.
def marketing_version_arg
  version = ENV["APP_VERSION"].to_s.strip.sub(/\Av/, "")
  version.empty? ? "" : " MARKETING_VERSION=#{version}"
end

def beta_build(platform:, destination:)
  register_bundle_ids unless ENV["CI"]
  key = load_app_store_connect_api_key
  sign(platform: platform)

  mac = platform == "macos"
  testflight_platform = mac ? "osx" : "ios"
  build_number = latest_testflight_build_number(
    api_key: key, app_identifier: APP_IDENTIFIER, platform: testflight_platform
  ) + 1
  build_params = {
    project: PROJECT,
    scheme: "Folio",
    configuration: "Release",
    destination: destination,
    # Folio is a multiplatform target; without the SDK gym cannot tell a Mac build from an iOS one and looks for an .ipa.
    sdk: mac ? "macosx" : "iphoneos",
    export_method: "app-store",
    export_team_id: TEAM_ID,
    xcargs: "#{XCODEBUILD_FLAGS} CURRENT_PROJECT_VERSION=#{build_number}#{marketing_version_arg}",
    output_directory: File.join(APPLE_DIR, "build", platform),
    clean: true
  }
  # The Mac App Store takes a signed installer package, not an .ipa.
  build_params.merge!(installer_cert_name: mac_installer_identity) if mac
  build_app(**build_params)

  artifact = mac ? { pkg: lane_context[SharedValues::PKG_OUTPUT_PATH] } : { ipa: lane_context[SharedValues::IPA_OUTPUT_PATH] }
  upload_to_testflight(
    api_key: key,
    app_identifier: APP_IDENTIFIER,
    app_platform: testflight_platform,
    changelog: changelog_since_last_tag,
    skip_waiting_for_build_processing: true,
    **artifact
  )
end

desc "Run FolioKit tests and build the app for iOS Simulator and macOS"
lane :test do
  sh("cd '#{APPLE_DIR}/FolioKit' && xcrun swift test")
  generate_project
  ["generic/platform=iOS Simulator", "platform=macOS"].each do |destination|
    sh("cd '#{APPLE_DIR}/Folio' && xcrun xcodebuild build -project Folio.xcodeproj -scheme Folio " \
       "-destination '#{destination}' #{XCODEBUILD_FLAGS} CODE_SIGNING_ALLOWED=NO")
  end
end

desc "One-time local setup: register bundle ids with App Groups, then create signing assets with match"
desc "  force:true regenerates the profiles"
lane :bootstrap do |options|
  register_bundle_ids
  force = options[:force].to_s == "true"
  sign(platform: "ios", force: force)
  sign(platform: "macos", force: force)
end

desc "Sign with match, build for iOS and upload to TestFlight"
lane :beta do
  generate_project
  beta_build(platform: "ios", destination: "generic/platform=iOS")
end

desc "Sign with match, build for macOS and upload to TestFlight"
lane :beta_mac do
  generate_project
  beta_build(platform: "macos", destination: "generic/platform=macOS")
end

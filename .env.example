# Folio Environment Configuration
# Copy this file to .env and fill in your values

# Server configuration (optional - defaults in config.toml)
# FOLIO_SERVER_HOST=127.0.0.1
# FOLIO_SERVER_PORT=3000

# Database configuration (optional - defaults in config.toml)
# FOLIO_DATABASE_URL=sqlite:folio.db?mode=rwc

# Storage configuration (optional - defaults in config.toml)
# FOLIO_STORAGE_PATH=./data

# AI Provider configuration
FOLIO_AI_PROVIDER=openai

# OpenAI API Key (required if using OpenAI provider)
FOLIO_AI_OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API Key (required if using Anthropic provider)
# FOLIO_AI_ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Logging level
RUST_LOG=folio_app=debug,folio_api=debug,folio_infra=debug,tower_http=debug

# Folio Environment Configuration
# Copy this file to .env and fill in your values.
# Every setting has a built-in default and config.toml is optional.
# Nested keys use a double underscore. See docs/configuration.md.

# Server configuration
# FOLIO_SERVER__HOST=127.0.0.1
# FOLIO_SERVER__PORT=3000
# FOLIO_SERVER__PUBLIC_URL=https://folio.example.com

# Database configuration
# FOLIO_DATABASE__URL=sqlite:folio.db?mode=rwc

# Storage configuration
# FOLIO_STORAGE__PATH=./data

# AI Provider configuration
FOLIO_AI__PROVIDER=openai

# OpenAI API Key (required if using OpenAI provider)
FOLIO_AI__OPENAI_API_KEY=your-openai-api-key-here
# Or read it from a file (Docker/Kubernetes secrets):
# FOLIO_AI__OPENAI_API_KEY_FILE=/run/secrets/openai_api_key

# Anthropic API Key (required if using Anthropic provider)
# FOLIO_AI__ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenTelemetry export (off unless an endpoint is set). See docs/observability.md.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer your-token,x-tenant-id=your-tenant
# OTEL_SERVICE_NAME=folio

# Logging level
RUST_LOG=folio_app=debug,folio_api=debug,folio_infra=debug,tower_http=debug

            "description": "Tag ID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTagRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The updated tag",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tag"
                }
              }
            }
          },
          "400": {
            "description": "The request is malformed or fails validation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "The resource does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "A resource with the same unique value already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "tags"
        ],
        "summary": "Delete a tag",
        "operationId": "deleteTag",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Tag ID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The tag was deleted"
          },
          "404": {
            "description": "The resource does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/events": {
      "get": {
        "tags": [
          "events"
        ],
        "summary": "Subscribe to real-time document events",
        "description": "Each SSE message has the event name from `DocumentEvent` (for example `created`)\nand a JSON `DocumentEvent` as data. Comment-only keep-alive frames are sent every 30 seconds.",
        "operationId": "streamEvents",
        "responses": {
          "200": {
            "description": "Stream of document events",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentEvent"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Correspondent": {
        "type": "object",
        "description": "A correspondent (sender/source) of documents",
        "required": [
          "id",
          "name",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the correspondent was created"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier"
          },
          "name": {
            "type": "string",
            "description": "Correspondent name (unique)"
          }
        }
      },
      "CreateCorrespondentRequest": {
        "type": "object",
        "description": "Request body for creating a correspondent",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "CreateDocumentRequest": {
        "type": "object",
        "description": "Request body for creating a document",
        "required": [
          "title"
        ],
        "properties": {
          "content": {
            "type": [
              "string",
              "null"
            ]
          },
          "correspondent_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "document_type_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "CreateDocumentTypeRequest": {
        "type": "object",
        "description": "Request body for creating a document type",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "CreateTagRequest": {
        "type": "object",
        "description": "Request body for creating a tag",
        "required": [
          "name"
        ],
        "properties": {
          "color": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Document": {
        "type": "object",
        "description": "A document in the system",
        "required": [
          "id",
          "title",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "content": {
            "type": [
              "string",
              "null"
            ],
            "description": "Extracted text content (from OCR or text extraction)"
          },
          "correspondent_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Associated correspondent (sender)"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the document was created in the system"
          },
          "document_type_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Document type classification"
          },
          "file_path": {
            "type": [
              "string",
              "null"
            ],
            "description": "Path to the stored file (relative to storage root)"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier"
          },
          "mime_type": {
            "type": [
              "string",
              "null"
            ],
            "description": "MIME type of the original document"
          },
          "original_filename": {
            "type": [
              "string",
              "null"
            ],
            "description": "Original filename when uploaded"
          },
          "page_count": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Number of pages in the document (for PDFs and multi-page images)",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "description": "Document title"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the document was last updated"
          }
        }
      },
      "DocumentEvent": {
        "oneOf": [
          {
            "type": "object",
            "description": "Document was created",
            "required": [
              "document_id",
              "type"
            ],
            "properties": {
              "document_id": {
                "type": "string",
                "format": "uuid"
              },
              "type": {
                "type": "string",
                "enum": [
                  "created"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "Document was updated (content, metadata, etc.)",
            "required": [
              "document_id",
              "type"
            ],
            "properties": {
              "document_id": {
                "type": "string",
                "format": "uuid"
              },
              "type": {
                "type": "string",
                "enum": [
                  "updated"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "Document thumbnail was generated",
            "required": [
              "document_id",
              "type"
            ],
            "properties": {
              "document_id": {
                "type": "string",
                "format": "uuid"
              },
              "type": {
                "type": "string",
                "enum": [
                  "thumbnail_ready"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "Document OCR completed",
            "required": [
              "document_id",
              "type"
            ],
            "properties": {
              "document_id": {
                "type": "string",
                "format": "uuid"
              },
              "type": {
                "type": "string",
                "enum": [
                  "ocr_complete"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "Document was deleted",
            "required": [
              "document_id",
              "type"
            ],
            "properties": {
              "document_id": {
                "type": "string",
                "format": "uuid"
              },
              "type": {
                "type": "string",
                "enum": [
                  "deleted"
                ]
              }
            }
          }
        ],
        "description": "Event types that can be broadcast to clients"
      },
      "DocumentListResponse": {
        "type": "object",
        "description": "Response for document list",
        "required": [
          "documents",
          "count"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "description": "Number of documents returned",
            "minimum": 0
          },
          "documents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Document"
            }
          }
        }
      },
      "DocumentType": {
        "type": "object",
        "description": "A document type for classification (e.g., Invoice, Receipt, Contract)",
        "required": [
          "id",
          "name",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the document type was created"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier"
          },
          "name": {
            "type": "string",
            "description": "Type name (unique)"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "description": "API error response",
        "required": [
          "error"
        ],
        "properties": {
          "details": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "type": "string",
            "description": "Human-readable error message"
          }
        }
      },
      "FileContent": {
        "type": "string",
        "format": "binary",
        "description": "Binary payload of a stored file"
      },
      "SearchRequest": {
        "type": "object",
        "description": "Search request body (for POST)",
        "required": [
          "query"
        ],
        "properties": {
          "limit": {
            "type": "integer",
            "description": "Maximum number of results",
            "default": 10,
            "minimum": 0
          },
          "query": {
            "type": "string",
            "description": "Natural-language query"
          }
        }
      },
      "SearchResponse": {
        "type": "object",
        "description": "Search response",
        "required": [
          "results"
        ],
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchResultWithDocument"
            }
          }
        }
      },
      "SearchResultWithDocument": {
        "type": "object",
        "required": [
          "document",
          "score"
        ],
        "properties": {
          "document": {
            "$ref": "#/components/schemas/Document"
          },
          "score": {
            "type": "number",
            "format": "float",
            "description": "Similarity score; higher is closer"
          }
        }
      },
      "Tag": {
        "type": "object",
        "description": "A tag for categorizing documents",
        "required": [
          "id",
          "name",
          "created_at"
        ],
        "properties": {
          "color": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional color for UI display (hex format, e.g., \"#ff5733\")"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the tag was created"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier"
          },
          "name": {
            "type": "string",
            "description": "Tag name (unique)"
          }
        }
      },
      "UpdateCorrespondentRequest": {
        "type": "object",
        "description": "Request body for updating a correspondent",
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "UpdateDocumentTypeRequest": {
        "type": "object",
        "description": "Request body for updating a document type",
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "UpdateTagRequest": {
        "type": "object",
        "description": "Request body for updating a tag",
        "properties": {
          "color": {
            "type": [
              "string",
              "null"
            ],
            "description": "Omit to keep the current color; send `null` to clear it"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "UploadDocumentRequest": {
        "type": "object",
        "description": "Multipart form accepted by the upload endpoint",
        "required": [
          "file"
        ],
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "description": "The file to store and run through OCR"
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "description": "Document title; defaults to the file name"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "documents",
      "description": "Documents and their files"
    },
    {
      "name": "tags",
      "description": "Tags for categorizing documents"
    },
    {
      "name": "correspondents",
      "description": "Senders of documents"
    },
    {
      "name": "document_types",
      "description": "Document classifications"
    },
    {
      "name": "events",
      "description": "Real-time updates"
    }
  ]
}
